# Task 24: settings for docker-compose.yml. Copy to ".env" next to it and fill in.
# ".env" is gitignored - never commit it, it holds real secrets.

# ---- Where the site lives -----------------------------------------------------
# Public hostname. A real hostname (DNS pointing at this machine) makes Caddy get a
# free HTTPS certificate automatically. For trying it locally use ":80".
SITE_ADDRESS=closet.example.com
# The same address as a URL (with https:// once the hostname is set). Used in the
# password-reset email links.
PUBLIC_URL=https://closet.example.com

# ---- Secrets (generate your own) -----------------------------------------------
# Any long random password for the database.
DB_PASSWORD=change-me
# Base64, e.g.:  openssl rand -base64 64
JWT_SECRET=change-me

# ---- Email (password-reset and confirmation codes) -----------------------------
# Gmail: turn on 2-Step Verification, then Google Account -> Security -> App
# passwords, and use that 16-character value as the password (NOT your normal one).
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=you@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_app_password
# Optional; Gmail requires the From address to be the account itself.
# MAIL_FROM=you@gmail.com

# ---- Image upload and background removal (public values, built into the site) ---
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
# browser = removed inside the visitor's browser (no extra server needed)
VITE_BG_REMOVER_MODE=browser
