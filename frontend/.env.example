# Cloudinary Configuration
# Get these from your Cloudinary Dashboard (Settings > Enable unsigned uploading)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here

# Background Removal Configuration
# Mode: browser | api | hybrid (default: hybrid)
VITE_BG_REMOVER_MODE=hybrid
# URL for the Python microservice
VITE_BG_REMOVER_API_URL=http://localhost:8000/remove-bg

# Production (Task 24) ----------------------------------------------------
# Leave unset when the site and the API share an origin (the docker-compose setup
# does this: Caddy serves the site and forwards /api to the backend). Set it only
# when the frontend is hosted separately from the backend, e.g.
# VITE_API_URL=https://api.example.com/api
# Note: every VITE_ variable is baked into the public JavaScript - never put a
# secret in one. (The Cloudinary upload preset is meant to be public.)
# VITE_API_URL=

# Sign in with Google (Task 98) --------------------------------------------
# The OAuth client id from Google Cloud Console (public; ends in .apps.googleusercontent.com). Empty
# = no Google button. The backend needs the same value as GOOGLE_CLIENT_ID. See DEPLOYMENT.md.
# VITE_GOOGLE_CLIENT_ID=

# Ads (Task 97) ------------------------------------------------------------
# Ads are for signed-in FREE accounts only (never premium users or admins) and are OFF unless
# VITE_AD_PROVIDER is set. Public values, baked into the site at build time.
# VITE_AD_PROVIDER=adsense | adsterra
#
# Google AdSense - needs a domain you own (it does not approve *.onrender.com):
# VITE_ADSENSE_CLIENT=ca-pub-1234567890123456
# VITE_ADSENSE_SLOT=1234567890
#
# Adsterra-style banner (accepts free subdomains). Copy the three values from the banner unit's
# code in the network's dashboard: the .../invoke.js address, the key, and the unit's size.
# Pick a size that fits a phone (320x50) or accept that it is hidden on narrow screens.
# VITE_ADSTERRA_SCRIPT_URL=https://www.example-network.com/your-unit-key/invoke.js
# VITE_ADSTERRA_KEY=your-unit-key
# VITE_ADSTERRA_WIDTH=728
# VITE_ADSTERRA_HEIGHT=90
