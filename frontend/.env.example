# Cloudinary Configuration
# Get these from your Cloudinary Dashboard (Settings > Enable unsigned uploading)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here

# Background Removal Configuration
# Mode: browser | api | hybrid (default: hybrid)
VITE_BG_REMOVER_MODE=hybrid
# URL for the Python microservice
VITE_BG_REMOVER_API_URL=http://localhost:8000/remove-bg

# Production (Task 24) ----------------------------------------------------
# Leave unset when the site and the API share an origin (the docker-compose setup
# does this: Caddy serves the site and forwards /api to the backend). Set it only
# when the frontend is hosted separately from the backend, e.g.
# VITE_API_URL=https://api.example.com/api
# Note: every VITE_ variable is baked into the public JavaScript - never put a
# secret in one. (The Cloudinary upload preset is meant to be public.)
# VITE_API_URL=
