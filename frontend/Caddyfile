# Task 24: web server config (see Dockerfile / docker-compose.yml).
#
# SITE_ADDRESS is the public hostname (e.g. closet.example.com): with a real
# hostname Caddy obtains and renews a free HTTPS certificate on its own (ports 80
# and 443 must reach this container). The default ":80" is plain HTTP for running
# the stack on your own machine.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# The API: forwarded to the backend container.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# The backend's health endpoint is for the platform's own checks, inside the
	# network - not for the public internet.
	handle /actuator/* {
		respond "Not found" 404
	}

	# Everything else is the React app. Unknown paths fall back to index.html so a
	# page opened directly or refreshed (/closet, /outfits/...) is handled by the
	# client-side router instead of a 404.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Hashed build files never change under the same name: cache them for a year.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Everything else (index.html, which every page falls back to, and the images)
	# is re-checked on each visit - cheap, since unchanged files answer 304 - so a
	# new deploy is picked up at once.
	@app not path /assets/* /api/*
	header @app Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
